          ]
        },
        {
          "id": "s-77e",
          "codified": {
            "num": "77e",
            "cite": "15 U.S.C. § 77e"
          },
          "original": {
            "num": "5",
            "cite": "Securities Act of 1933 § 5"
          },
          "heading": "Prohibitions relating to interstate commerce and the mails",
          "status": "active",
          "content": [
            {
              "type": "subsection",
              "num": "a",
              "heading": "Sale or delivery after sale of unregistered securities",
              "children": [
                {
                  "type": "chapeau",
                  "text": "Unless a registration statement is in effect as to a security, it shall be unlawful for any person, directly or indirectly—"
                },
                {
                  "type": "paragraph",
                  "num": "1",
                  "heading": "",
                  "text": "to make use of any means or instruments of transportation or communication in interstate commerce or of the mails to sell such security through the use or medium of any prospectus or otherwise; or"
                },
                {
                  "type": "paragraph",
                  "num": "2",
                  "heading": "",
                  "text": "to carry or cause to be carried through the mails or in interstate commerce, by any means or instruments of transportation, any such security for the purpose of sale or for delivery after sale. See also section 77j of this title."
                }
              ]
            }
          ],
          "source_credit": "(May 27, 1933, ch. 38, title I, § 5, 48 Stat. 77.)",
          "notes": [
            {
              "heading": "Short Title of 2015 Amendment",
              "blocks": [
                {
                  "type": "section",
                  "text": "501SHORT TITLE OF PHONY NOTE.This note is a test fixture."
                }
              ]
            }
          ]
